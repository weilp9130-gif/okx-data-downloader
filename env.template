# ============ OKX API 配置 ============
# 从 https://www.okx.com/account/my-api 获取
# 生产环境
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 沙箱环境(测试)
# OKX_SANDBOX=true 表示使用模拟盘; false 表示真实盘
OKX_SANDBOX=false

# 请求限速配置
OKX_RATE_LIMIT_PER_SECOND=20
OKX_MAX_RETRIES=5
OKX_RETRY_BACKOFF=2.0

# ============ 数据库配置 ============
# PostgreSQL + TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=okx_data
DB_SCHEMA=public
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_MAX_BYTES=10485760   # 10MB
LOG_BACKUP_COUNT=5

# ============ 数据下载配置 ============
# 默认交易对
DEFAULT_INSTRUMENT=ETH-USDT-SWAP
DEFAULT_CHAIN=ETH-USDT

# 默认K线时间粒度
DEFAULT_BAR=1m

# 数据下载时间范围
DEFAULT_START_DATE=2024-01-01
DEFAULT_END_DATE=2025-12-31

# ============ 其他 ============
# 时区
TIMEZONE=Asia/Shanghai
