# ============ OKX API 配置 ============
# 从 https://www.okx.com/account/my-api 获取
# 生产环境
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 沙箱环境(测试)
# OKX_SANDBOX=true 表示使用模拟盘; false 表示真实盘
OKX_SANDBOX=false

# 请求限速配置
OKX_RATE_LIMIT_PER_SECOND=20
OKX_MAX_RETRIES=5
OKX_RETRY_BACKOFF=2.0

# ============ IP代理池配置（一个币一个IP并行下载） ============
# 突破单IP限频的关键：提供多个"不同出口IP"的代理。
# 方式一（推荐，动态）：用 --dynamic 每次下载前自动发现节点/测IP/应用，
#   兼容节点IP经常变化的VPN服务商，无需手工维护下面的列表：
#     python sync_continuous.py --dynamic --pool-size 16
# 方式二（静态）：手动配置本地监听端口列表（动态模式生成的 listeners 配置
#   位于 runtime/mihomo_listeners.yaml，可用 OKX_PROXY_URLS 直接复用）：
#   OKX_PROXY_URLS=http://127.0.0.1:7891,http://127.0.0.1:7892,http://127.0.0.1:7893,...
# 每个IP的请求限速（OKX按IP限频约20请求/2秒，实测8~10/s最稳；程序已用平滑
# 限速器消除突发，勿设过高否则触发429）
OKX_IP_RATE_LIMIT_PER_SECOND=8
# Clash/Mihomo 自动发现（配合 --dynamic 使用）
# CLASH_API_URL=http://127.0.0.1:9097
# CLASH_PROXY_URL=http://127.0.0.1:7890
# 并发建议：--workers 设为 IP 数×2（每IP保持2线程），如 --pool-size 16 时
# 用 --workers 32，实测约 73 页/秒且无429。

# ============ 数据库配置 ============
# PostgreSQL + TimescaleDB
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=okx_data
DB_SCHEMA=public
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ============ Docker数据库引导（可选，下载前自动启动） ============
# 运行下载/同步脚本前自动检测数据库：
#   DB_HOST:DB_PORT 可连接 -> 直接用现有数据库；
#   不可达且本机有Docker -> 自动创建/启动 timescale 容器并等待就绪。
# DB_USE_DOCKER=auto   # auto=不可达时自动用Docker启动(默认)，true=同auto，false=绝不动Docker
# DB_CONTAINER_NAME=okx-timescaledb
# DB_DOCKER_IMAGE=timescale/timescaledb:latest-pg16
# DB_DOCKER_VOLUME=okx-timescaledb-data   # 命名卷，数据持久化，删除容器不丢数据

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_MAX_BYTES=10485760   # 10MB
LOG_BACKUP_COUNT=5

# ============ 数据下载配置 ============
# 默认交易对
DEFAULT_INSTRUMENT=ETH-USDT-SWAP
DEFAULT_CHAIN=ETH-USDT

# 默认K线时间粒度
DEFAULT_BAR=1m

# 数据下载时间范围
DEFAULT_START_DATE=2024-01-01
DEFAULT_END_DATE=2025-12-31

# ============ OrderBook WebSocket 配置（Phase 6/10） ============
# 频道深度与权限：
#   books           400档 增量推送  无VIP要求（默认）
#   books5          5档   全量推送  无VIP要求
#   bbo-tbt         1档   全量推送  无VIP要求
#   books50-l2-tbt  50档  增量推送  需 VIP4+
#   books-l2-tbt    400档 增量推送  需 VIP5+
ORDERBOOK_CHANNEL=books
# 本地 OrderBookState 持久化为 order_book_snapshots 的间隔（秒）
ORDERBOOK_SNAPSHOT_INTERVAL=5
# 快照写库保留档位数（控制 JSONB 体积；因子仍按完整盘口计算）
ORDERBOOK_SNAPSHOT_LEVELS=5
# 订阅需要 VIP 权限的频道时必须显式置为 true，否则启动即报错
ORDERBOOK_ALLOW_VIP=false

# ============ Retention 配置（Phase 10，默认关闭） ============
# Retention != 永久删除：启用前应先导出冷存储（Parquet/CSV）
RETENTION_ENABLED=false
# 0 = 不设置该表的 retention policy
RETENTION_ORDER_BOOK_SNAPSHOTS_DAYS=30
RETENTION_ORDER_BOOK_FACTORS_DAYS=0
RETENTION_TRADES_DAYS=0

# ============ Raw 数据冲突对账策略 ============
# ws     = WS 实时通道为权威（默认）：库中已有 WS 值且 incoming 为 REST 时，
#          保留 WS 值、跳过写入、不登记冲突（OKX 对 count>1 聚合成交的
#          WS/REST sz 口径不一致属已知行为）
# strict = 严格模式：任何同键不同 payload 都登记 data_conflicts，需人工裁决
DATA_CONFLICT_POLICY=ws

# ============ WebSocket 配置 ============
# OKX WS 公共行情地址（默认走 443：wss://ws.okx.com/ws/v5/public；
# 8443 端口在部分网络被阻断，可显式指定）
# OKX_WS_URL=wss://ws.okx.com/ws/v5/public

# ============ 下载范围配置 ============
# download_scope.toml 路径（币种区域/时间区域/下载默认值），默认项目根目录
# DOWNLOAD_SCOPE=download_scope.toml

# ============ 其他 ============
# 时区
TIMEZONE=Asia/Shanghai

# ============ Web 管理后台（OKX Quant Platform） ============
# webui.py（FastAPI）监听地址
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8000
# worker.py（独立任务 Worker）标识与轮询间隔
# WORKER_NAME=worker-1
# WORKER_NODE=local
# WORKER_POLL_INTERVAL=2
